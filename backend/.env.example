# Required — generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Set to True for local development only
DJANGO_DEBUG=True

# Comma-separated, e.g. sarkarialert.com,www.sarkarialert.com
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS origins for frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# IndexNow key (optional)
INDEXNOW_KEY=d4b9766fae9545049bb8a1278c201405

# Site URL for IndexNow
SITE_URL=https://sarkarialert.com